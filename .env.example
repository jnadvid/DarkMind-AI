# DarkMind-AI — Configuración del entorno
# Copia este archivo a .env y rellena tus valores.

# ============================================================
# Configuración del LLM
# ============================================================

# Host LLM principal (por defecto: localhost)
LLM_HOST=localhost

# Hosts LLM adicionales, separados por comas (para el descubrimiento de modelos)
# Usa solo nombres de host/IPs; DarkMind-AI escanea los puertos de servicio comunes, incluido el 11434 de Ollama.
# LLM_HOSTS=llm-host.local,backup-llm.local

# URL base de Ollama opcional. Si Ollama se ejecuta en otro host o en la red local,
# apunta aquí. Cuando Ollama escucha en todas las interfaces: OLLAMA_HOST=0.0.0.0:11434.
# OLLAMA_BASE_URL=http://localhost:11434/v1

# URL de LM Studio opcional. Apunta aquí si LM Studio está configurado
# para servir en todas las interfaces (0.0.0.0).
# LM_STUDIO_URL=http://localhost:1234

# Clave de API de OpenAI (solo necesaria si usas modelos de OpenAI).
# No confirmes claves reales. Mantén esto comentado hasta que sea necesario.
# OPENAI_API_KEY=your_openai_api_key_here

# Endpoint LLM del servicio de investigación
# RESEARCH_LLM_ENDPOINT=http://localhost:8000/v1/chat/completions

# Paquete de CA adicional para proveedores LLM cuya cadena TLS no está en el
# almacén de confianza por defecto. Se añade POR ENCIMA del paquete del sistema / certifi —
# la verificación permanece activa para cada host, el conjunto de confianza simplemente aumenta. Útil para:
#   - GigaChat / Sber (CA Raíz de Confianza Rusa): sin esto, el endpoint
#     aparece como desconectado con CERTIFICATE_VERIFY_FAILED — certificado autofirmado
#     en la cadena de certificados.
#   - Gateways LLM corporativos / de empresa con una CA interna.
# Apunta a un archivo PEM que contenga las raíces faltantes.
# LLM_CA_BUNDLE=/etc/darkmind/ca/extra-roots.pem

# ============================================================
# Búsqueda y web
# ============================================================

# URL de la instancia SearXNG (autoalojada, para búsqueda web).
# Si ejecutas SearXNG en el mismo host, déjalo en localhost:8080.
SEARXNG_INSTANCE=http://localhost:8080

# Secreto de cookie/CSRF de SearXNG opcional. Si está en blanco, se genera
# automáticamente al arrancar por primera vez.
# SEARXNG_SECRET=

# ============================================================
# Base de datos
# ============================================================

# Ruta de la base de datos SQLite (por defecto: sqlite:///./data/app.db)
# DATABASE_URL=sqlite:///./data/app.db

# ============================================================
# Autenticación y seguridad
# ============================================================

# Habilitar autenticación (por defecto: true)
# AUTH_ENABLED=true

# Dirección de enlace y puerto para la interfaz web de DarkMind-AI.
# Mantén APP_BIND en loopback salvo que quieras intencionadamente acceso LAN/proxy-inverso.
# APP_BIND=127.0.0.1
# Cambia esto si otro servicio local ya usa el 7000 (AirPlay en macOS suele hacerlo).
# APP_PORT=7000

# Omisión de autenticación solo para desarrollo en solicitudes de loopback.
# Mantén en false para despliegues en red y cualquier entorno compartido.
# LOCALHOST_BYPASS=false

# Marca las cookies de sesión como Secure. Establece true cuando DarkMind-AI
# se sirva a través de HTTPS mediante un proxy inverso de confianza o puerta de acceso privada.
# SECURE_COOKIES=true

# Opcional: predefinir la primera contraseña de administrador durante la configuración.
# No confirmes una contraseña real.
# DARKMIND_ADMIN_PASSWORD=change_me_before_first_boot

# Orígenes permitidos en CORS (por defecto: solo localhost; restringe a tu origen público en producción)
# ALLOWED_ORIGINS=http://localhost:7000,http://localhost:8000

# ============================================================
# ChromaDB (almacén vectorial)
# ============================================================

# Host del servicio ChromaDB.
# Ejecución manual en el host: localhost:8100 al usar `docker run -p 8100:8000 chromadb/chroma`
# o cuando ChromaDB se ejecuta de forma independiente en el puerto 8100.
# CHROMADB_HOST=localhost
# CHROMADB_PORT=8100

# Dirección de enlace y URL base para ntfy (notificaciones push).
# Por defecto solo loopback. Para exponer ntfy solo en Tailscale,
# establece NTFY_BIND en la IP de Tailscale de tu host y actualiza NTFY_BASE_URL.
# NTFY_BIND=127.0.0.1
# NTFY_BASE_URL=http://localhost:8091
# Ejemplo:
# NTFY_BIND=100.x.y.z
# NTFY_BASE_URL=http://100.x.y.z:8091

# ============================================================
# RAG / Embeddings
# ============================================================

# Endpoint de la API de embeddings (compatible con OpenAI /v1/embeddings)
# Por defecto: http://{LLM_HOST}:11434/v1/embeddings (ollama)
# EMBEDDING_URL=http://localhost:11434/v1/embeddings

# Nombre del modelo de embeddings (debe estar disponible en el endpoint anterior)
# EMBEDDING_MODEL=all-minilm:l6-v2

# Modelo de embeddings de reserva local (usado cuando no hay API HTTP de embeddings disponible)
# Usa fastembed (ONNX) — descarga el modelo en la primera ejecución (~50 MB)
# FASTEMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# FASTEMBED_CACHE_PATH=  # por defecto ~/.cache/fastembed

# ============================================================
# Miscelánea
# ============================================================

# Intervalo de limpieza en horas (por defecto: 24)
# CLEANUP_INTERVAL_HOURS=24

# Sondeos de correo en proceso (por defecto: activos). Establece a 0 si estás controlando
# el sondeo desde cron / systemd con `scripts/darkmind-mail poll-scheduled`
# y `scripts/darkmind-mail poll-summary`, para evitar que ambos planificadores
# compitan sobre el mismo SQLite.
# DARKMIND_INPROCESS_POLLERS=1

# Ejecutor de tareas programadas en proceso (por defecto: activo). Establece a 0 para dejar que un
# controlador externo dispare las tareas programadas. Los recordatorios del calendario son
# controlados por el frontend (sondeo de /api/notes desde el navegador), así que no se necesita gate aquí.
# DARKMIND_INPROCESS_TASKS=1

# Host usado por la acción de tarea programada «run_script» integrada.
# Vacío/local/localhost ejecuta scripts en el host de la aplicación. Establece un alias de host SSH
# si quieres intencionadamente que los scripts programados se ejecuten de forma remota.
# DARKMIND_SCRIPT_HOST=localhost
